# ===========================================
# Portfolio Frontend Environment Variables
# ===========================================

# Backend API URL
# Point this to your Express.js backend server
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ===========================================
# Deployment Notes
# ===========================================

# For Vercel Deployment:
# 1. Go to your Vercel project settings
# 2. Navigate to Environment Variables section
# 3. Add NEXT_PUBLIC_API_URL with your production backend URL
#    Example: https://your-backend.herokuapp.com/api
#           or https://api.yourdomain.com

# For Local Development:
# 1. Copy this file to .env.local
# 2. Update the values as needed
# 3. Make sure your backend server is running

# ===========================================
# Backend Requirements
# ===========================================

# Your backend should have the following API endpoints:

# Authentication:
# POST /api/auth/register - Create new user
# POST /api/auth/login - Login user
# GET  /api/auth/me - Get current user

# Projects:
# GET    /api/projects - Get all projects (supports ?category, ?featured, ?search)
# GET    /api/projects/:id - Get single project
# POST   /api/projects - Create project (auth required)
# PUT    /api/projects/:id - Update project (auth required)
# DELETE /api/projects/:id - Delete project (auth required)

# Contact (optional):
# POST /api/contact - Send contact message
